[Unit]
Description=MCP Studio production backup
After=mcp-studio.service

[Service]
Type=oneshot
User=alfred
Group=alfred
WorkingDirectory=/home/alfred/mcp-studio
Environment=MCP_STUDIO_CONFIG=/home/alfred/mcp-studio/config.yaml
ExecStart=/home/alfred/mcp-studio/.venv/bin/python /home/alfred/mcp-studio/scripts/backup-production.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/alfred/mcp-studio/backups /home/alfred/mcp-studio/data
